      "mods": { "nullable": true },
      "pre": { "sql": ["update documents set document_type = 'UNSTRUCTURED' where document_type is null"] }
    },
    { "object": "constraint", "action": "add", "name": "documents_document_type_check", "reference": "documents" },
    { "object": "column", "action": "rename", "name": "location", "newname": "file_location", "reference": "documents" },
    { "object": "fk", "action": "drop", "name": "documents_old_fk", "reference": "documents" },
    {
      "object": "script", "description": "seed the default tags",
      "sql": [
