{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "skima state editor API",
    "version": "1",
    "description": "skima serve's local API: read the state files, edit tables, and build the changeset for the edits. Served on localhost only, without authentication. State objects use their file format - see the JSON schemas in pkg/manifest/schemas. See docs/specs/state-editor-api.md."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7012"
    }
  ],
  "paths": {
    "/api/v1/openapi.json": {
      "get": {
        "summary": "This document",
        "responses": {
          "200": {
            "description": "The OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/manifest": {
      "get": {
        "summary": "Working directory, baseline, latest changeset version, object counts and a validation summary",
        "parameters": [
          {
            "name": "baseline",
            "in": "query",
            "required": false,
            "description": "A git ref to compare with, instead of the server's default baseline",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The manifest summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Manifest"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/validation": {
      "get": {
        "summary": "Validation results for every manifest file, as skima manifest validate --output=json",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Make changeset reference problems newer than this version errors",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Per-file validation results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FileValidation"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/state/{kind}": {
      "get": {
        "summary": "The names of the state objects of a kind",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "description": "tables, views, enums, sequences or matviews",
            "schema": {
              "enum": [
                "tables",
                "views",
                "enums",
                "sequences",
                "matviews"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The names, sorted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "names": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/E404"
          }
        }
      }
    },
    "/api/v1/state/{kind}/{name}": {
      "get": {
        "summary": "A state object's file, exactly as it is, with its ETag",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "description": "tables, views, enums, sequences or matviews",
            "schema": {
              "enum": [
                "tables",
                "views",
                "enums",
                "sequences",
                "matviews"
              ]
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "The object's name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file content",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "The object's version - send it in If-Match to edit it",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          }
        }
      }
    },
    "/api/v1/state/tables": {
      "post": {
        "summary": "Create a table",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://raw.githubusercontent.com/johnmuhlestein/skima/main/pkg/manifest/schemas/table.schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The table was created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "The object's version - send it in If-Match to edit it",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "422": {
            "$ref": "#/components/responses/E422"
          }
        }
      }
    },
    "/api/v1/state/tables/{table}": {
      "patch": {
        "summary": "Set or clear the table comment",
        "description": "An empty comment removes it",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "The ETag of the table you read",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "path",
            "required": true,
            "description": "The table's name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The edit was made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "The object's version - send it in If-Match to edit it",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "412": {
            "$ref": "#/components/responses/E412"
          },
          "422": {
            "$ref": "#/components/responses/E422"
          },
          "428": {
            "$ref": "#/components/responses/E428"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "comment"
                ],
                "additionalProperties": false,
                "properties": {
                  "comment": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Drop a table",
        "description": "Other tables' foreign keys that reference it and sequences its columns own block the drop, unless cascade is true",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "The ETag of the table you read",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "path",
            "required": true,
            "description": "The table's name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cascade",
            "in": "query",
            "required": false,
            "description": "true to also drop what uses it, as postgres does",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The edit was made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "The object's version - send it in If-Match to edit it",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "412": {
            "$ref": "#/components/responses/E412"
          },
          "422": {
            "$ref": "#/components/responses/E422"
          },
          "428": {
            "$ref": "#/components/responses/E428"
          }
        }
      }
    },
    "/api/v1/state/tables/{table}/columns": {
      "post": {
        "summary": "Add a column",
        "description": "A NOT NULL column with no default on a table that has rows needs a backfill - recorded as a hint, so the changeset adds it nullable, fills it, then makes it NOT NULL",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "The ETag of the table you read",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "path",
            "required": true,
            "description": "The table's name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "The edit was made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "The object's version - send it in If-Match to edit it",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "412": {
            "$ref": "#/components/responses/E412"
          },
          "422": {
            "$ref": "#/components/responses/E422"
          },
          "428": {
            "$ref": "#/components/responses/E428"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "https://raw.githubusercontent.com/johnmuhlestein/skima/main/pkg/manifest/schemas/table.schema.json#/$defs/column"
                  }
                ],
                "properties": {
                  "backfill": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "expression": {
                        "type": "string"
                      },
                      "script": {
                        "type": "string"
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "expression"
                        ]
                      },
                      {
                        "required": [
                          "script"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/state/tables/{table}/columns/{column}": {
      "patch": {
        "summary": "Change a column, or rename it",
        "description": "Sending name renames the column - on its own, not with other changes. A rename cascades to keys, indexes, constraints, other tables' foreign keys and owned sequences, and is recorded as a hint so the changeset renames rather than drops and adds the column",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "The ETag of the table you read",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "path",
            "required": true,
            "description": "The table's name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "column",
            "in": "path",
            "required": true,
            "description": "The column's name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The edit was made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "The object's version - send it in If-Match to edit it",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "412": {
            "$ref": "#/components/responses/E412"
          },
          "422": {
            "$ref": "#/components/responses/E422"
          },
          "428": {
            "$ref": "#/components/responses/E428"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "datatype": {
                    "type": "string"
                  },
                  "nullable": {
                    "type": "boolean"
                  },
                  "default": {
                    "type": "string"
                  },
                  "dfltfunc": {
                    "type": "boolean"
                  },
                  "comment": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Drop a column",
        "description": "The primary key, indexes, constraints and foreign keys that use it, other tables' foreign keys and owned sequences block the drop, unless cascade is true",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "The ETag of the table you read",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "path",
            "required": true,
            "description": "The table's name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "column",
            "in": "path",
            "required": true,
            "description": "The column's name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cascade",
            "in": "query",
            "required": false,
            "description": "true to also drop what uses it, as postgres does",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The edit was made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "The object's version - send it in If-Match to edit it",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "412": {
            "$ref": "#/components/responses/E412"
          },
          "422": {
            "$ref": "#/components/responses/E422"
          },
          "428": {
            "$ref": "#/components/responses/E428"
          }
        }
      }
    },
    "/api/v1/state/tables/{table}/primary-key": {
      "put": {
        "summary": "Set the primary key",
        "description": "",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "The ETag of the table you read",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "path",
            "required": true,
            "description": "The table's name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The edit was made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "The object's version - send it in If-Match to edit it",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "412": {
            "$ref": "#/components/responses/E412"
          },
          "422": {
            "$ref": "#/components/responses/E422"
          },
          "428": {
            "$ref": "#/components/responses/E428"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "columns"
                ],
                "additionalProperties": false,
                "properties": {
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove the primary key",
        "description": "Other tables' foreign keys that reference it block the removal, unless cascade is true",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "The ETag of the table you read",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "path",
            "required": true,
            "description": "The table's name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cascade",
            "in": "query",
            "required": false,
            "description": "true to also drop what uses it, as postgres does",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The edit was made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "The object's version - send it in If-Match to edit it",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "412": {
            "$ref": "#/components/responses/E412"
          },
          "422": {
            "$ref": "#/components/responses/E422"
          },
          "428": {
            "$ref": "#/components/responses/E428"
          }
        }
      }
    },
    "/api/v1/state/tables/{table}/{collection}/{name}": {
      "put": {
        "summary": "Add or replace a foreign key, index, constraint or trigger",
        "description": "The body is the object in its file format; its name, when given, must match the path",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "The ETag of the table you read",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "path",
            "required": true,
            "description": "The table's name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "description": "foreign-keys, indexes, constraints or triggers",
            "schema": {
              "enum": [
                "foreign-keys",
                "indexes",
                "constraints",
                "triggers"
              ]
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "The object's name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The edit was made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "The object's version - send it in If-Match to edit it",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "412": {
            "$ref": "#/components/responses/E412"
          },
          "422": {
            "$ref": "#/components/responses/E422"
          },
          "428": {
            "$ref": "#/components/responses/E428"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "https://raw.githubusercontent.com/johnmuhlestein/skima/main/pkg/manifest/schemas/table.schema.json#/$defs/foreignKey"
                  },
                  {
                    "$ref": "https://raw.githubusercontent.com/johnmuhlestein/skima/main/pkg/manifest/schemas/table.schema.json#/$defs/index"
                  },
                  {
                    "$ref": "https://raw.githubusercontent.com/johnmuhlestein/skima/main/pkg/manifest/schemas/table.schema.json#/$defs/constraint"
                  },
                  {
                    "$ref": "https://raw.githubusercontent.com/johnmuhlestein/skima/main/pkg/manifest/schemas/table.schema.json#/$defs/trigger"
                  }
                ]
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Drop a foreign key, index, constraint or trigger",
        "description": "",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "The ETag of the table you read",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "path",
            "required": true,
            "description": "The table's name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "description": "foreign-keys, indexes, constraints or triggers",
            "schema": {
              "enum": [
                "foreign-keys",
                "indexes",
                "constraints",
                "triggers"
              ]
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "The object's name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The edit was made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "The object's version - send it in If-Match to edit it",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "412": {
            "$ref": "#/components/responses/E412"
          },
          "422": {
            "$ref": "#/components/responses/E422"
          },
          "428": {
            "$ref": "#/components/responses/E428"
          }
        }
      }
    },
    "/api/v1/changes": {
      "get": {
        "summary": "How the state changed since the baseline, the deltas generated for it, warnings, unsupported changes and the SQL",
        "parameters": [
          {
            "name": "baseline",
            "in": "query",
            "required": false,
            "description": "A git ref to compare with, instead of the server's default baseline",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The changes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Changes"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          }
        }
      }
    },
    "/api/v1/changes/hints": {
      "get": {
        "summary": "The recorded rename and backfill hints",
        "responses": {
          "200": {
            "description": "The hints",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hints": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Hint"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/changes/hints/{id}": {
      "delete": {
        "summary": "Discard a hint - e.g. to treat a rename as a drop and an add after all",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The hint's id, e.g. rename:documents.file_loc",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The hint was discarded"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          }
        }
      }
    },
    "/api/v1/changesets": {
      "post": {
        "summary": "Write the changeset for the changes as the next changeset, and clear the hints",
        "description": "Refused (409) while a changeset is not committed yet, when nothing changed, and when some changes generate no deltas unless acknowledgeUnsupported is true. The written changeset is validated as apply would; an invalid one is removed (422)",
        "parameters": [
          {
            "name": "baseline",
            "in": "query",
            "required": false,
            "description": "A git ref to compare with, instead of the server's default baseline",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "description"
                ],
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "bump": {
                    "enum": [
                      "patch",
                      "minor",
                      "major"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "description": "An explicit version newer than every changeset, instead of bump"
                  },
                  "transaction": {
                    "type": "boolean",
                    "description": "false for statements that can't run in a transaction"
                  },
                  "acknowledgeUnsupported": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The changeset was written",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "422": {
            "$ref": "#/components/responses/E422"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "400": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "Conflict - see error.code",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "412": {
        "description": "The file changed since it was read (stale ETag) - read it again",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "422": {
        "description": "Invalid - see error.issues",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "428": {
        "description": "If-Match is required on edits",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "e.g. invalid_edit, referenced, stale, not_found, exists, pending_changeset, unsupported_changes, no_changes"
              },
              "message": {
                "type": "string"
              },
              "issues": {
                "type": "array"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "changes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Change"
                }
              }
            }
          }
        }
      },
      "EditResponse": {
        "type": "object",
        "properties": {
          "table": {
            "$ref": "https://raw.githubusercontent.com/johnmuhlestein/skima/main/pkg/manifest/schemas/table.schema.json",
            "description": "The edited table - absent when it was dropped"
          },
          "etag": {
            "type": "string"
          },
          "written": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deleted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "renames": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "table": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Change": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "added",
              "removed",
              "changed",
              "renamed"
            ]
          },
          "object": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Changes": {
        "type": "object",
        "properties": {
          "baseline": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              }
            }
          },
          "pendingChangesets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            }
          },
          "unsupported": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deltas": {
            "type": "array",
            "items": {
              "$ref": "https://raw.githubusercontent.com/johnmuhlestein/skima/main/pkg/manifest/schemas/changeset.schema.json#/$defs/delta"
            }
          },
          "sql": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sqlError": {
            "type": "string"
          }
        }
      },
      "Hint": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "rename",
              "backfill"
            ]
          },
          "table": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "column": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "script": {
            "type": "string"
          }
        }
      },
      "BuildResponse": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "changeset": {
            "$ref": "https://raw.githubusercontent.com/johnmuhlestein/skima/main/pkg/manifest/schemas/changeset.schema.json"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unsupported": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            }
          }
        }
      },
      "FileValidation": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "issues": {
            "type": "array"
          }
        }
      },
      "Manifest": {
        "type": "object",
        "properties": {
          "workdir": {
            "type": "string"
          },
          "baseline": {
            "type": "object"
          },
          "baselineError": {
            "type": "string"
          },
          "latestVersion": {
            "type": "string"
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "validation": {
            "type": "object",
            "properties": {
              "files": {
                "type": "integer"
              },
              "valid": {
                "type": "integer"
              },
              "invalid": {
                "type": "integer"
              },
              "warnings": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
